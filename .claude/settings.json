{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check src/ --quiet 2>&1 | head -20; python -m ruff format src/ --quiet 2>&1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- セッション終了 ---' && echo '進捗を docs/progress.md に反映してください'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(uvicorn*)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(pip*)",
      "Bash(docker*)"
    ]
  }
}
