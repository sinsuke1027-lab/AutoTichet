# Microsoft Graph API 認証情報（IT管理者から受け取る）
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Microsoft Planner 設定
PLANNER_GROUP_ID=your-m365-group-id
PLANNER_PLAN_ID=your-planner-plan-id

# 部署グループID → PlannerプランID マッピング（JSON形式）
DEPT_PLAN_MAP={"m365-group-id-1": "planner-plan-id-1"}

# アクセス制限: 処理対象ユーザーのAzure ADオブジェクトIDまたはUPNをカンマ区切りで指定
# 必ず設定すること（空の場合はテナント全ユーザーが対象になる）
# IT管理者から受け取ったユーザーIDを記載する
ALLOWED_USER_IDS=user-guid-1,user-guid-2,user-guid-3,user-guid-4,user-guid-5

# Langfuse 監査ログ（Docker起動後に設定）
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_HOST=http://localhost:3000

# ポーリング設定
POLLING_INTERVAL_SECONDS=300

# 信頼スコア閾値
AUTO_CREATE_THRESHOLD=0.8
MANUAL_REVIEW_THRESHOLD=0.5

# ===== LLMプロバイダー設定 =====
# テキスト処理プロバイダー（gemini | claude | azure_openai | ollama）
LLM_PROVIDER=gemini
# 画像処理プロバイダー（gemini | claude | azure_openai | ollama）
LLM_VISION_PROVIDER=gemini

# 注意: Pattern B（機密データ）は Phase 3 以降でローカルLLM（Ollama）に強制ルーティング予定

# Gemini API（デフォルト）
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash

# Claude API（LLM_PROVIDER=claude の場合）
ANTHROPIC_API_KEY=sk-ant-your-key

# Azure OpenAI（LLM_PROVIDER=azure_openai の場合）
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Ollama（ローカルLLM・Phase 3 以降）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llama3.2-vision

# ===== PostgreSQL（新規追加）=====
DATABASE_URL=postgresql+asyncpg://autoticket:autoticket@localhost:5432/autoticket

# ===== フロントエンド認証（MSAL）=====
AZURE_CLIENT_ID_FRONTEND=your-spa-client-id
FRONTEND_URL=http://localhost:5173

# ===== Microsoft Forms / SharePoint 連携 =====
SHAREPOINT_SITE_ID=your-sharepoint-site-id
FORMS_LIST_ID=your-forms-response-list-id

# ===== 開発用バイパスモード（本番では絶対に true にしない）=====
# true にすると JWT 検証をスキップし、X-Dev-User ヘッダーを信頼する
DEV_MODE=false
